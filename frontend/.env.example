# Configuración para el proyecto con las dos bases centrales (clínica ficticia y CONTIGO).
VITE_USE_MOCKS=false
# Ruta del mismo origen: Vite la redirige al backend local del servidor, también al entrar desde otro PC.
VITE_API_BASE_URL=/api/v1
